# ============================================================================
# SARRAF — Environment Variables Template (.env.example)
# Copy to .env and fill in values for your deployment environment.
# NEVER commit real API keys or secrets to version control.
# ============================================================================

# Optional Client-Side Price Override URL (defaults to backend proxy /api/price/xauusd)
VITE_PRICE_API_URL=/api/price/xauusd

# Optional Public Canonical Base URL for SEO / Share links
VITE_PUBLIC_SITE_URL=https://sarraf.app

# Server-Side Gold Price Feed / Broker Configuration (used by server.ts, never exposed to client)
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
MT5_BRIDGE_URL=
MT5_BRIDGE_SECRET=

# Server-Side Session & Invite-Only Admin Auth
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Telegram Bot Relay Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# SARRAF WHALES (24/7 AI zone agent) — all optional
# Gemini key above (GEMINI_API_KEY) turns on AI choice; without it the rules engine plans.
WHALES_GEMINI_MODEL=
WHALES_AI_VOTES=1            # 1-3 Gemini calls per plan (majority vote)
WHALES_REPLAN_MINUTES=60     # normal re-plan interval (events re-plan sooner)
WHALES_SL_MIN=10             # stop loss window in $
WHALES_SL_MAX=12
OANDA_API_TOKEN=             # free OANDA practice token -> XAU_USD order-book levels
OANDA_ENV=practice           # practice | live
ADMIN_TOKEN=                 # needed for POST /api/sarraf-whales/replan
