# ==============================================================================
# SARRAF Institutional XAU/USD Spot Analysis & Telegram Dispatch System
# Production Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Storage & Persistence (Mount persistent volume here)
# All candles, signals, outbox, settings, and rolling backups live in DATA_DIR.
DATA_DIR=./data

# Institutional Desk Authentication (httpOnly Cookie Sessions)
ADMIN_USERNAME=gmc
ADMIN_PASSWORD_HASH=$2b$12$5OFtxGetourV8NFLWKED0OlN0nwy9DmH2NSrvU7NlrhK3AwxNpJFq

# Telegram Bot Relay Configuration
# Create bot via @BotFather and retrieve bot token.
TELEGRAM_BOT_TOKEN=
# Private Telegram Channel or Group ID (e.g., -1001234567890)
TELEGRAM_CHAT_ID=

# Google Chat Collaboration & Pre-Flight Review Security (Phase 4 Extension)
# Whitelist of authorized Google accounts permitted to approve/reject setups or curate lessons (comma-separated)
GOOGLE_ALLOWED_EMAILS=a.h216saleem@gmail.com,admin@sarraf.gold
# Optional default flag for Google Chat pre-review (default: false, OFF)
GOOGLE_CHAT_PRE_REVIEW=false

# Google Gemini Intelligence Model Validator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AHMED AI Primary Engine (Mistral / Any OpenAI-Compatible API)
AI_BASE_URL=https://api.mistral.ai/v1
AI_API_KEY=
AI_MODEL=mistral-small

# Operational Modes
# Set to 'false' for live broadcasting to Telegram; 'true' logs to outbox without network dispatch.
DRY_RUN=true

# Timezone Display
DISPLAY_TZ=UTC

# Ephemeral filesystem flag (set to 'true' if running on stateless server without persistent disk)
EPHEMERAL_FILESYSTEM=false

# SPY (S&P 500) Options Market Data Layer
# Primary: Alpaca Free Plan (feed=iex). Single shared connection, trades + quotes + bars
ALPACA_KEY_ID=
ALPACA_SECRET=

# Fallback: Twelve Data REST API (Max 8 calls/min, 800 calls/day; polled at most once per minute only if Alpaca is down)
TWELVEDATA_KEY=

# US10Y Treasury Yield Data (FRED API - series DGS10; optional, supplements live CNBC/Yahoo intraday US10Y feed)
FRED_API_KEY=

